@page "/logout"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NetGameProjectBlazor.Components.Account.Identity
@using NetGameProjectBlazor.Data
@inject IAccountManagement Acct
@inject SignInManager<ApplicationUser> SignInManager




<PageTitle>Logga ut</PageTitle>

<AuthorizeView @ref="authView">
    <Authorized>
        <div class="alert alert-info">Loggar ut...</div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-success">Du har loggats ut.</div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AuthorizeView? authView;
    protected override async Task OnInitializedAsync()
    {
        if (await Acct.CheckAuthenticatedAsync())
        {
            await Acct.LogoutAsync();
            // await SignInManager.SignOutAsync();
        }
        await base.OnInitializedAsync();
    }
}