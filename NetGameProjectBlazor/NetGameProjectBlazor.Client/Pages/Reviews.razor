@using NetGameProjectBlazor.Shared.DTOs
@using MudBlazor
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient httpClient

<MudText>@_message</MudText>

@if (ReviewList == null || ReviewList.Count() == 0)
{
    <MudText>Inga recensioner hittades.</MudText>
}
else
{
    <MudDivider Style="background-color: #937878; height: 4px; margin: 8px;" />

    <h3>Reviews</h3>

    <MudContainer Class="carousel-wrapper">
    <MudCarousel ItemsSource="ReviewChunks"
                 ShowArrows="true"
                 ShowBullets="false"
                 AutoCycle="true"
                 Style="max-width: auto;
                        overflow: hidden;
                        height: 200px"
                 class="pb-12">
            <ItemTemplate Context="reviewChunk">
                <MudGrid Justify="Justify.Center">
                    @foreach (var review in reviewChunk)
                    {
                        var user = UserList.FirstOrDefault(u => u.Id == review.CustomerId);
                        if (user != null)
                        {
                            <MudItem xs="12" sm="4" Class="d-flex justify-center">
                                <MudCard Class="d-flex flex-column h-100" Style="margin: 16px; width: 100%; max-width: 300px;" Elevation="2">
                                    <MudCardContent Class="flex-grow-1 d-flex flex-column">
                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.subtitle1">@user.FullName</MudText>
                                            </MudItem>
                                            <MudItem xs="6" class="d-flex justify-end">
                                                <MudText Typo="Typo.caption">
                                                    @(review.CreatedDate?.ToString("d MMMM yyyy", new CultureInfo("sv-SE")) ?? "Datum saknas")
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>

                                        <MudGrid Class="mt-1">
                                            <MudItem xs="12" class="d-flex justify-start">
                                                @for (var i = 0; i < review.Rating; i++)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                                }
                                            </MudItem>
                                        </MudGrid>

                                        <MudGrid>
                                            <MudItem xs="12" class="d-flex justify-start">
                                                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">
                                                    @review.ReviewText
                                                </MudText>
                                            </MudItem>
                                        </MudGrid>

                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    }
                </MudGrid>
            </ItemTemplate>
    </MudCarousel>
    </MudContainer>
}

@code {
    [Parameter] public int? productId { get; set; }
    private List<ReviewDto> ReviewList;
    private List<UserDto> UserList = new();
    private List<List<ReviewDto>> ReviewChunks = new();
    string _message;

    private List<List<ReviewDto>> ChunkBy(List<ReviewDto> source, int chunkSize)
    {
        return source
            .Select((x, i) => new { Index = i, Value = x })
            .GroupBy(x => x.Index / chunkSize)
            .Select(g => g.Select(x => x.Value).ToList())
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await httpClient.GetAsync($"api/review/{productId}");
            if (response.IsSuccessStatusCode)
            {
                ReviewList = await response.Content.ReadFromJsonAsync<List<ReviewDto>>();

                if (ReviewList?.Any() == true)
                {
                    ReviewChunks = ChunkBy(ReviewList, 3);

                    var userResponse = await httpClient.GetAsync("api/users");
                    if (userResponse.IsSuccessStatusCode)
                    {
                        UserList = await userResponse.Content.ReadFromJsonAsync<List<UserDto>>();
                    }
                }
            }
            else
            {
                _message = $"Fel vid hämtning av recensioner: {response.ReasonPhrase}";
            }
        }
        catch
        {
            _message = "Fel vid anslutning till databasen.";
        }
    }
    
}
