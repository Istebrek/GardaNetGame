@page "/"
@using System.Net.Http.Json 
@using System.Threading 
@using MudBlazor
@using NetGameProjectBlazor.Shared.DTOs
@inject HttpClient httpClient 
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<PageTitle>Startsida</PageTitle>
<MudText>@_message</MudText>


<MudContainer Class="homepage-slogan-container mt-5 mb-5" Elevation="1">
    <MudText class="homepage-slogan-text mt-2 mb-2">
        ⭐ GÅRDANETGAMET <span class="px-2"></span>
        🏆 Bäst på onlinespel! <span class="px-2"></span>
        ⚡ Spela smart, spela snabbt, vinn stort! <span class="px-2"></span>
        🚀 Bäst på onlinespel! <span class="px-2"></span>
        🎯 Utmana vänner och dominera topplistan! <span class="px-2"></span>
        🎮 Bäst på onlinespel!
    </MudText>
</MudContainer>

<MudCarousel TData="string" ItemsSource="@images" Class="mud-width-full mb-5" Style="height:400px;">
    <ItemTemplate>
        <MudImage Src="@context"
                  ObjectFit="ObjectFit.Fill"
                  Alt="Bild"
                  Style="width:100%; height:400px; display:block;" />
    </ItemTemplate>
</MudCarousel>

<MudStack Row="true" AlignItems="AlignItems.Baseline" Class="w-100 d-flex justify-content-between">
    <MudText Typo="Typo.h4" Class=" mt-5">
        PC Spel
        <MudIcon Icon="@Icons.Material.Filled.VideogameAsset" Class="me-1" Size="Size.Large" />
    </MudText>
    
    <MudButton 
        Class=" mt-5"
        EndIcon="@Icons.Material.Filled.ArrowForward"
        Style="color: white; background-color: #937878CC;" 
        Href="/game">
        Se alla spel
    </MudButton>
</MudStack>

<MudGrid Justify="Justify.Center" Spacing="2" Style="max-width: 100%; overflow-x: hidden; margin-top: 20px">
    @foreach (var game in Games)
    {
        <MudItem xs="12" sm="6" md="4" lg="4" Style="max-width: 100%; padding: 10px;">
            <MudCard Class="no-border"
            Style="display: flex; flex-direction: column; height: 100%; width: 100%; max-width: 100%; margin: 0 auto;">
                <MudCardMedia Image="@game.ProductImageUrl"
                Style="width: 100%; height: 180px; object-fit: contain; background-color: white;" />
                <MudCardContent Style="flex-grow: 1; display: flex; flex-direction: column;">
                    <MudText Typo="Typo.h5"
                    Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; width: 100%; max-width: 100%;">
                        @game.Name
                    </MudText>
                    <MudText Typo="Typo.body2" Style="margin: 10px;">@game.Price kr</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                    Style="width: 100%; border-radius: 0; background-color: #937878CC; color: white;"
                    Href=@($"/game/{game.Id}")>Läs mer</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (recGame != null)
{
    <MudGrid Justify="Justify.Center" Class="mt-16">
        <MudItem xs="12">
            <MudText Typo="Typo.h4" Align="Align.Center">
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Small" />
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Medium" />
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Large" />
                Rekomenderade
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Large" />
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Medium" />
                <MudIcon Icon="@Icons.Material.Filled.Star" Class="me-1" Size="Size.Small" />
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="12" md="8" lg="6" xl="4"
        Style="display: flex; justify-content: center;">
            <MudCard Class="no-border"
            Style="width: 100%; max-width: 400px;">
                <MudCardMedia Image="@recGame.ProductImageUrl"
                Style="width: 100%; height: 180px; object-fit: contain; background-color: white;" />
                <MudCardContent>
                    <MudText Typo="Typo.h5"
                    Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                        @recGame.Name
                    </MudText>
                    <MudText Typo="Typo.body2" Style="margin: 10px;">@recGame.Price kr</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                    Style="width: 100%; border-radius: 0; background-color: #937878CC; color: white;"
                    Href=@($"/game/{recGame.Id}") >
                        Läs mer
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
}


<MudStack Row="true" AlignItems="AlignItems.Baseline" Class="w-100 d-flex justify-content-between mt-16">
    <MudText Typo="Typo.h4">
        Tillbehör
        <MudIcon Icon="@Icons.Material.Filled.Keyboard" Class="me-1" Size="Size.Large" />
    </MudText>
    <MudButton 
        EndIcon="@Icons.Material.Filled.ArrowForward"
        Style="color: white; background-color: #937878CC;"
        Href="/physicalProduct"
    >Se alla tillbehör  </MudButton>
</MudStack>

<MudGrid Justify="Justify.Center" Spacing="2" Style="max-width: 100%; overflow-x: hidden; margin-top: 20px">
    @foreach (var product in Products)
    {
        <MudItem xs="12" sm="6" md="4" lg="4" Style="max-width: 100%; padding: 10px;">
            <MudCard Class="no-border"
            Style="display: flex; flex-direction: column; height: 100%; width: 100%; max-width: 100%; margin: 0 auto;">
                <MudCardMedia Image="@product.ProductImageUrl"
                Style="width: 100%; height: 250px; object-fit: cover;" />
                <MudCardContent Style="flex-grow: 1; display: flex; flex-direction: column;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="margin: 10px; overflow: hidden;">
                        <MudText Typo="Typo.h5"
                        Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; width: 100%; max-width: 100%;">
                            @product.Name
                        </MudText>
                        <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord"
                        Style=@($"font-size: 14px; color: {((product.IsActive ?? false) ? "#66BB6A" : "#616161")};") />
                    </MudStack>
                    <MudText Typo="Typo.body2" Style="margin: 10px;">@product.Price kr</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton 
                        Variant="Variant.Filled"
                        Style="width: 100%; border-radius: 0; background-color: #937878CC; color: white;"
                        Href=@($"/product/{product.Id}")
                    >
                        Läs mer
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>


@code {
    private List<PhysicalProductDto>? Products = new List<PhysicalProductDto>();
    private List<GamesOverviewDto>? Games = new List<GamesOverviewDto>();
    string _message = string.Empty;
    private GamesOverviewDto? recGame;

    private List<string> images = new()
    {
      "/images/NetGame.png",
      "/images/NetGame3.png",
      "/images/NetGame2.png"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await httpClient.GetAsync("api/physicalProducts");
            if (response.IsSuccessStatusCode)
            {
                Products = await response.Content.ReadFromJsonAsync<List<PhysicalProductDto>>();
                Products = Products.Take(3).ToList();
            }
            else
            {
                _message = response.ReasonPhrase;
            }

            response = await httpClient.GetAsync("api/games");
            if (response.IsSuccessStatusCode)
            {
                Games = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
                Console.WriteLine(Games);
                recGame = Games.Last();
                var featuredGame = Games.FirstOrDefault(g => g.Id == 35);
                Games = Games.Take(6).ToList();
            }
            else
            {
                _message = response.ReasonPhrase;
            }
        }
        catch
        {
            _message = "Fel vid anslutning till databas";
        }
    }

    private void NavigateToGameDetails(int productId)
    {
        NavigationManager.NavigateTo($"/game/{productId}");
    }
    private void NavigateToProductDetails(int productId)
    {
        NavigationManager.NavigateTo($"/product/{productId}");
    }
}

