@page "/product/{ProductId:int}"
@using System.Net.Http.Json
@using System.Threading
@using MudBlazor
@using NetGameProjectBlazor.Shared.DTOs

@inject HttpClient httpClient
@inject UserState userState
@inject GuestCartService GuestCart
@rendermode InteractiveWebAssembly

@if (productDto == null)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{
	<MudText>@_message</MudText>

	<MudContainer Class="d-flex justify-center align-center" Style="height: 100vh; padding: 16px;">
		<MudStack Row="true" Spacing="3">
			<MudGrid Justify="Justify.Center">
				<MudItem xs="12" sm="6" Class="d-flex justify-center">
					<MudImage Src=@productDto.ProductImageUrl
							  Elevation="25" Alt="Product image"
							  Class="rounded-lg"
							  FallbackSrc="https://www.shutterstock.com/image-vector/default-ui-image-placeholder-wireframes-600nw-1037719192.jpg"
							  Style=" object-fit: contain; max-width: 80%; max-height : 80%" />
				</MudItem>
				<MudItem xs="12" sm="6">
					<MudText Style="color: #000; font-size: 32px; font-weight: 400;" class="mb-5">@productDto.Name</MudText>
					<MudStack Row="true">
						@if (rating == 0)
						{
							<MudText>Det finns inga recensioner än</MudText>
						}
						@for (int i = 0; i < FullStars(rating); i++)
						{
							<MudIcon Title="Full Star" Icon="@Icons.Material.Filled.Star" Color="Color.Warning"></MudIcon>
						}
						@if (HasHalfStar(rating))
						{
							<MudIcon Title="Half Star" Icon="@Icons.Material.Filled.StarHalf" Color="Color.Warning"></MudIcon>
						}
					</MudStack>
					<MudDivider Style="background-color: #937878; height: 4px; margin-top: 8px;" />
					<MudText Style="color: #000;
								font-size: 16px;
								font-weight: 400px;
								line-height: 25px;
								margin-top: 20px;">@productDto.Description</MudText>
					<MudText Style="color: #000;
								font-weight: 400;
								font-size: 16px;
								margin-top: 50px;">Lager: @productDto.StockQuantity</MudText>
					<MudText Style="color: #000;
								font-weight: 400;
								font-size: 24px;
								margin-top: 15px;">@productDto.Price kr</MudText>
					<MudButton Style="width: 458px;
								height: 48px;
								padding: 10px;
								justify-content: center;
								align-items: center;
								gap: 10px;
								background-color: rgba(147, 120, 120, 0.80);
								color: #FFFFFF;
								margin-top: 50px;"
							   OnClick="@(() => AddProductToCart(productDto.Id))">
						Lägg i varukorgen
					</MudButton>
					@if (!string.IsNullOrEmpty(_productAdded))
					{
						<MudAlert Severity="Severity.Success">@_productAdded</MudAlert>
					}
				</MudItem>
			</MudGrid>
		</MudStack>
	</MudContainer>

	<Reviews ProductId="@ProductId" />
}



@code {
	[Parameter] public int ProductId { get; set; }
	private List<ReviewDto> ReviewList = new List<ReviewDto>();
	PhysicalProductDto productDto;
	string _message;
	string _productAdded;
	decimal rating = 0;

	public int cartId;



	protected override async Task OnInitializedAsync()
	{
		try
		{
			await userState.GetUserInfo();
			cartId = userState.CartId;
			var response = await httpClient.GetAsync($"api/physicalProducts/{ProductId}");
			if (response.IsSuccessStatusCode)
			{
				try
				{
					productDto = await response.Content.ReadFromJsonAsync<PhysicalProductDto>();

					var rResponse = await httpClient.GetAsync($"api/review/{productDto.Id}");
					if (rResponse.IsSuccessStatusCode)
					{
						var content = await rResponse.Content.ReadFromJsonAsync<List<ReviewDto>>();
						if (content != null && content.Any())
						{
							rating = content.Average(r => (decimal)r.Rating);
						}
					}
				}
				catch (Exception ex)
				{
					_message = ex.Message;
					productDto = TempData();
					rating = 0;
				}
			}
			else productDto = TempData();

			response = await httpClient.GetAsync($"api/review/{ProductId}");
			if (response.IsSuccessStatusCode)
			{
				ReviewList = await response.Content.ReadFromJsonAsync<List<ReviewDto>>();

				foreach (var review in ReviewList)
				{
					rating += review.Rating;
				}

				if (ReviewList.Count == 0)
				{
					return;
				}
				else
				{
					rating /= ReviewList.Count();
				}
			}

		}
		catch (Exception ex)
		{
			_message = ex.Message;
			productDto = TempData();
		}
	}

	private async Task AddProductToCart(int productId)
	{
		try
		{
			if (userState.IsSignedIn)
			{
				var response = await httpClient.PostAsJsonAsync($"api/cart/item/{cartId}", new ShoppingCartItemCreateDto
					{
						ProductId = productDto.Id,
						Quantity = 1,
						PriceAtPurchase = productDto.Price
					});

				if (response.IsSuccessStatusCode)
				{
					_productAdded = $"{productDto.Name} har lagts till i varukorgen.";
				}
			} else
			{
				await GuestCart.AddAsync(new ShoppingCartItemDto
				{
					ProductId = productDto.Id,
					Quantity = 1,
					PriceAtPurchase = productDto.Price,
					ProductImageUrl = productDto.ProductImageUrl,
					ProductName = productDto.Name
				});
				_productAdded = $"{productDto.Name} har lagts till i varukorgen.";
			}
		}
		catch (Exception)
		{

			throw;
		}
	}

	private int FullStars(decimal rating)
	{
		var fractional = rating - Math.Floor(rating);
		if (fractional >= 0.75m) return Convert.ToInt32(Math.Floor(rating) + 1);

		return Convert.ToInt32(Math.Floor(rating));
	}

	private bool HasHalfStar(decimal rating)
	{
		var fractional = rating - Math.Floor(rating);
		return fractional < 0.75m && fractional >= 0.35m;
	}

	private PhysicalProductDto TempData()
	{
		var tempDto = new PhysicalProductDto()
			{
				Id = 0,
				Description = "test",
				Name = "Test",
				Price = 0,
				IsActive = true,
				ProductImageUrl = "https://www.shutterstock.com/image-vector/default-ui-image-placeholder-wireframes-600nw-1037719192.jpg",
				StockQuantity = 0
			};
		return tempDto;
	}
}
