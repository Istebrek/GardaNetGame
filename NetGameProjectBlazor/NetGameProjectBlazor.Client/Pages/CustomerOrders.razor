@code {
    // [Parameter] public string userId { get; set; }
    private List<GamesOverviewDto> AllGames;
    private GamesOverviewDto game1;
    private GamesOverviewDto game2;
    private GamesOverviewDto game3;
    private GamesOverviewDto game4;
    private GamesOverviewDto game5;
    private GamesOverviewDto game6;
    private GamesOverviewDto game7;
    private GamesOverviewDto game8;
    private GamesOverviewDto game9;

    protected override async Task OnInitializedAsync()
    {
        try
        {            
            var response = await httpClient.GetAsync("api/games");
            Console.WriteLine(" Gick att hitta alla spel");
            if (response.IsSuccessStatusCode)
            {
                AllGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
                game1 = AllGames.FirstOrDefault(g => g.Id == 1);
                game2 = AllGames.FirstOrDefault(g => g.Id == 2);
                game3 = AllGames.FirstOrDefault(g => g.Id == 3);
                game4 = AllGames.FirstOrDefault(g => g.Id == 4);
                game5 = AllGames.FirstOrDefault(g => g.Id == 5);
                game6 = AllGames.FirstOrDefault(g => g.Id == 6);
                game7 = AllGames.FirstOrDefault(g => g.Id == 7);
                game8 = AllGames.FirstOrDefault(g => g.Id == 8);
                game9 = AllGames.FirstOrDefault(g => g.Id == 9);
                Console.WriteLine("Gick att hitta spel");

            }
        } catch (Exception ex)
        {
            Console.WriteLine(ex.Message + " Gick inte att hitta spel");
        }
    }
}