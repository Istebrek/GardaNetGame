@page "/game/{ProductId:int}"
@using System.Net.Http.Json
@using System.Threading
@using MudBlazor
@using NetGameProjectBlazor.Shared.DTOs
@inject HttpClient httpClient
@inject AuthenticationStateProvider AuthStateProvider
@inject UserState userState
@inject GuestCartService GuestCart
@rendermode InteractiveWebAssembly

<MudContainer Class="d-flex justify-center align-center" Style="height: 100vh; padding: 16px;">
	<MudStack Row="true" Spacing="3">
		<MudGrid Justify="Justify.Center">
			<MudItem xs="12" sm="6" Class="d-flex justify-center">
				<MudImage Src="@GameInfo.ProductImageUrl" Elevation="25" Class="rounded-lg" Style="object-fit: contain;
					width: 467px;
					height: 218.272px;
					flex-shrink: 0;">
				</MudImage>
			</MudItem>


			<MudItem xs="12" sm="6">
				<MudText Class="mb-1" Style="color: #000; font-size: 32px; font-weight: 400;">@GameInfo.Name</MudText>
				<MudStack Row="true" Class="mb-5">
					@if (rating == 0)
					{
						<MudText>Det finns inga recensioner än</MudText>
					}
					@for (int i = 0; i < FullStars(rating); i++)
					{
						<MudIcon Title="Full Star" Icon="@Icons.Material.Filled.Star" Color="Color.Warning"></MudIcon>
					}
					@if (HasHalfStar(rating))
					{
						<MudIcon Title="Half Star" Icon="@Icons.Material.Filled.StarHalf" Color="Color.Warning"></MudIcon>
					}
				</MudStack>
				<MudStack Row="true">
					@foreach (var genre in GenresForGame)
					{
						<MudButton Variant="Variant.Filled" Style="background-color: rgba(147, 120, 120, 0.80);
						color: #FFF;
						font-size: 16px;
						font-weight: 400;
						line-height: normal;
						font-style: normal;
						width: auto;
						height: auto;">@genre.Name</MudButton>
					}
				</MudStack>
				<MudText Style="color: #000;
					font-size: 16px;
					font-weight: 400px;
					line-height: 25px;
					margin-top: 20px;">
					@GameInfo.Description
				</MudText>
				<MudText Style="color: #000;
					font-weight: 400;
					font-size: 24px;
					margin-top: 50px;">
					@GameInfo.Price kr
				</MudText>
				<MudButton Style="width: 458px;
					height: 48px;
					padding: 10px;
					justify-content: center;
					align-items: center;
					gap: 10px;
					background-color: rgba(147, 120, 120, 0.80);
					color: #FFFFFF;
					margin-top: 50px;" OnClick="@(() => AddGameToCart(GameInfo.Id))">
					Lägg i varukorgen
				</MudButton>
				@if (!string.IsNullOrEmpty(_productAdded))
				{
					<MudAlert Severity="Severity.Success">@_productAdded</MudAlert>
				}
			</MudItem>

		</MudGrid>

	</MudStack>

</MudContainer>

<MudContainer>
	<Reviews ProductId="@ProductId" />

</MudContainer>

@code {
	[Parameter] public int ProductId { get; set; }
	public GameDetailDto GameInfo { get; set; } = new();
	public List<GenreForGameDto> GenresForGame { get; set; } = [];
	private List<ReviewDto> ReviewList = new List<ReviewDto>();

	decimal rating = 0;

	private string _productAdded;

	private string? userId;
	private int cartId;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await userState.GetUserInfo();
			if (userState.IsSignedIn)
			{
				userId = userState.UserId;
			}
			cartId = userState.CartId;

			GameInfo = new GameDetailDto();
			GenresForGame = new List<GenreForGameDto>();
			var response = await httpClient.GetAsync($"/api/games/details/{ProductId}");
			if (response.IsSuccessStatusCode)
			{
				GameInfo = await response.Content.ReadFromJsonAsync<GameDetailDto>();
				var genreResponse = await httpClient.GetAsync($"/api/genres/genre-for-games/{GameInfo.Id}");
				if (genreResponse.IsSuccessStatusCode)
				{
					GenresForGame = await genreResponse.Content.ReadFromJsonAsync<List<GenreForGameDto>>();
				}
			}

			response = await httpClient.GetAsync($"api/review/{ProductId}");
			if (response.IsSuccessStatusCode)
			{
				ReviewList = await response.Content.ReadFromJsonAsync<List<ReviewDto>>();

				foreach (var review in ReviewList)
				{
					rating += review.Rating;
				}
				if (ReviewList.Count > 0) rating /= ReviewList.Count();
				else rating /= 1;
			}
		}
		catch (Exception)
		{
			throw;
		}
	}

	public async Task AddGameToCart(int productId)
	{
		try
		{
			if (userState.IsSignedIn)
			{
				var response = await httpClient.PostAsJsonAsync($"api/cart/item/{cartId}", new ShoppingCartItemCreateDto
				{
					ProductId = GameInfo.Id,
					Quantity = 1,
					PriceAtPurchase = GameInfo.Price
				});

				if (response.IsSuccessStatusCode)
				{
					_productAdded = $"{GameInfo.Name} har lagts till i varukorgen.";
				}
			} else
			{
				await GuestCart.AddAsync(new ShoppingCartItemDto
				{
					ProductId = GameInfo.Id,
					Quantity = 1,
					PriceAtPurchase = GameInfo.Price,
					ProductImageUrl = GameInfo.ProductImageUrl,
					ProductName = GameInfo.Name
				});
				_productAdded = $"{GameInfo.Name} har lagts till i varukorgen.";
			}
		}
		catch (Exception)
		{
			throw;
		}
	}
	private int FullStars(decimal rating)
	{
		var fractional = rating - Math.Floor(rating);
		if (fractional >= 0.75m) return Convert.ToInt32(Math.Floor(rating) + 1);

		return Convert.ToInt32(Math.Floor(rating));
	}

	private bool HasHalfStar(decimal rating)
	{
		var fractional = rating - Math.Floor(rating);
		return fractional < 0.75m && fractional >= 0.35m;
	}
}
