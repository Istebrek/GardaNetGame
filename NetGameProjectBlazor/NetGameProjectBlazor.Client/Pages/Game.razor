@page "/game"
@using System.Net.Http.Json
@using System.Threading
@using MudBlazor
@using NetGameProjectBlazor.Shared.DTOs
@inject HttpClient httpClient
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserState userState
@inject GuestCartService GuestCart
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<MudText Typo="Typo.h1" Align="Align.Center" Style="margin: m-2">Spel</MudText>

@if (AllGames == null)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{

	if (!string.IsNullOrEmpty(_message))
	{
		<MudAlert Severity="Severity.Error">@_message</MudAlert>
	}


	<MudPaper Class="pa-4">
		<MudStack Spacing="2">
			<MudButton OnClick="OnExpandCollapseClick" EndIcon="@Icons.Material.Rounded.ModeEditOutline">Filter</MudButton>
			<MudDivider />
			<MudCollapse Expanded="_expanded">
				<MudPaper Class="pa-2" Style="max-width: 400px;">
					<MudTextField Label="Genre" @bind-Value="@genreSearchText" Placeholder="Sök..."
					Adornment="Adornment.End"
					AdornmentIcon="@Icons.Material.Filled.Search"
					OnAdornmentClick="PerformGenreSearch"
					Immediate="true" />
				</MudPaper>

				<MudPaper Class="pa-2" Style="max-width: 400px;">
					<MudTextField Label="Namn på spel" @bind-Value="@nameSearchText" Placeholder="Sök..."
					Adornment="Adornment.End"
					AdornmentIcon="@Icons.Material.Filled.Search"
					OnAdornmentClick="PerformNameSearch"
					Immediate="true" />
				</MudPaper>

				<MudPaper Class="pa-2" Style="max-width: 400px;">
					<MudTextField Label="Pris" @bind-Value="@priceSearch" Placeholder="Sök..."
					Adornment="Adornment.End"
					AdornmentIcon="@Icons.Material.Filled.Search"
					OnAdornmentClick="SortGamesByPrice"
					Immediate="true" />
				</MudPaper>

				<div style="margin-top: 20px; width: 300px;">
					<label for="ageSelect">PEGI:</label>
					<select id="ageSelect" @bind="SelectedAgeRestriction" class="form-control">
						<option value="0">Alla åldersgränser...</option>
						@foreach (var age in AllAgeRestrictions)
						{
							<option value="@age.Id">@age.Age</option>
						}
					</select>
				</div>

				<MudButton Variant="Variant.Filled"
				Style="background-color: rgba(147, 120, 120, 0.80);
						color: #FFF;
						font-size: 16px;
						font-weight: 400;
						line-height: normal;
						font-style: normal;
						width: auto;
						height: auto;"
				OnClick="ClearFilter">Rensa filter</MudButton>


				<MudButton EndIcon="@SortPriceIcon" OnClick="SortByPrice">Pris </MudButton>
				<MudButton EndIcon="@SortNameIcon" OnClick="SortByName">Namn </MudButton>
			</MudCollapse>
		</MudStack>
	</MudPaper>
	@if (!string.IsNullOrEmpty(_productAdded))
	{
		<MudAlert Severity="Severity.Success">@_productAdded</MudAlert>
	}
	<MudGrid Justify="Justify.Center" Spacing="2" Style="max-width: 100%; overflow-x: hidden; margin-top: 20px">
		@foreach (var game in VisibleGames)
		{
			<MudItem xs="12" sm="6" md="4" lg="4" Style="max-width: 100%; padding: 10px;">
				<MudCard Class="no-border"
				Style="display: flex; flex-direction: column; height: 100%; width: 100%; max-width: 100%; margin: 0 auto;">
					<MudCardMedia Image="@game.ProductImageUrl"
					Style="width: 100%; height: 180px; object-fit: contain; background-color: white;" />
					<MudCardContent Style="flex-grow: 1; display: flex; flex-direction: column;">
						<MudText Typo="Typo.h5"
						Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; width: 100%; max-width: 100%;">
							@game.Name
						</MudText>
						<MudText Typo="Typo.body2" Style="margin: 10px;">@game.Price kr</MudText>
						<MudButton StartIcon="@Icons.Material.Outlined.ShoppingCart" OnClick="@(() => AddtoCart(game))">
						</MudButton>
					</MudCardContent>
					<MudCardActions>
						<MudButton Variant="Variant.Filled"
						Style="width: 100%; border-radius: 0; background-color: #937878CC; color: white;"
						Href=@($"/game/{game.Id}")>Läs mer</MudButton>
					</MudCardActions>
				</MudCard>
			</MudItem>
		}
	</MudGrid>
}

@code {
	private bool isLoggedIn;
	private string userId;
	private string _productAdded;

	private List<GamesOverviewDto> VisibleGames = new List<GamesOverviewDto>();
	private List<GamesOverviewDto> AllGames = new List<GamesOverviewDto>();
	private List<PegiNameDto> AllAgeRestrictions = new List<PegiNameDto>();
	private int userCart;
	private List<ShoppingCartDto?>? _shoppingCart = new();

	private int _selectedAgeRestriction;



	public int SelectedAgeRestriction
	{
		get { return _selectedAgeRestriction; }
		set
		{
			_selectedAgeRestriction = value;
			SortGamesByAgeRestriction();
		}
	}

	private bool _clearable = true;

	private string _message;
	private string genreSearchText;
	private string nameSearchText;

	private int minValue = 0;
	private int maxValue = 1000;

	private decimal priceSearch;


	private bool isPriceAsc = true;
	private bool isNameAsc = true;

	private string SortPriceIcon => isPriceAsc
	? Icons.Material.Filled.ArrowUpward
	: Icons.Material.Filled.ArrowDownward;
	private string SortNameIcon => isNameAsc
	? Icons.Material.Filled.ArrowUpward
	: Icons.Material.Filled.ArrowDownward;

	bool _expanded = false;

	private void NavigateToDetails(int productId)
	{
		NavigationManager.NavigateTo($"/game/{productId}");
	}

	private async Task ClearFilter()
	{
		_message = string.Empty;
		genreSearchText = string.Empty;
		nameSearchText = string.Empty;
		priceSearch = 0;
		SelectedAgeRestriction = 0;

		VisibleGames = AllGames.ToList();
		StateHasChanged();

	}

	private async void PerformGenreSearch()
	{
		try
		{
			_message = string.Empty;
			var response = await httpClient.GetAsync($"api/games/by-genre/{genreSearchText}");
			if (response.IsSuccessStatusCode)
			{
				VisibleGames.Clear();
				VisibleGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
			}
			else
			{
				_message = response.ReasonPhrase;
			}
		}
		catch (Exception ex)
		{
			_message = ex.Message;
		}
		StateHasChanged();
	}

	private async Task SortGamesByAgeRestriction()
	{
		_message = string.Empty;

		if (SelectedAgeRestriction == 0)
		{
			VisibleGames.Clear();

			try
			{

				var response = await httpClient.GetAsync("api/games");
				if (response.IsSuccessStatusCode)
				{
					AllGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
					if (AllGames != null) VisibleGames = AllGames.ToList();

				}
				else
				{
					_message = response.ReasonPhrase; ;
					TempData();

				}
			}
			catch (Exception ex)
			{
				_message = $"Error connecting to database: {ex.Message}";
				TempData();

			}
		}
		else
		{

			try
			{

				var response = await httpClient.GetAsync($"api/games/by-age/{SelectedAgeRestriction}");
				if (response.IsSuccessStatusCode)
				{
					VisibleGames.Clear();
					VisibleGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
				}
				else
				{
					_message = response.ReasonPhrase;
				}
			}
			catch (Exception ex)
			{

				_message = $"Ett fel uppstod: {ex.Message}";
			}
		}

		StateHasChanged();
	}

	private async Task SortGamesByPrice()
	{
		try
		{
			var response = await httpClient.GetAsync($"api/games/by-price/{priceSearch}");
			if (!response.IsSuccessStatusCode)
			{
				_message = response.ReasonPhrase;
			}
			else
			{
				VisibleGames.Clear();
				VisibleGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
			}
		}
		catch (Exception ex)
		{

			_message = $"Ett fel uppstod: {ex.Message}";
		}
	}

	// private void SortPriceRange()
	// {
	// 	_message = string.Empty;
	// 	if (minValue <= maxValue)
	// 	{
	// 		VisibleGames.Clear();
	// 		foreach (var product in AllGames)
	// 		{
	// 			if (product.Price <= maxValue && product.Price >= minValue)
	// 			{
	// 				VisibleGames.Add(product);
	// 			}
	// 		}
	// 		if (VisibleGames.Count == 0)
	// 		{
	// 			_message = "There is no games matching this range";
	// 			VisibleGames = AllGames.ToList();
	// 		}
	// 	}
	// 	else _message = "There is no games matching this range";

	// 	StateHasChanged();
	// }

	private void PerformNameSearch()
	{
		_message = string.Empty;
		VisibleGames.Clear();
		foreach (var product in AllGames)
		{
			if (product.Name.ToLower().Contains(nameSearchText.ToLower())) VisibleGames.Add(product);
		}
		if (VisibleGames.Count() == 0)
		{
			_message = $"Det finns inget spel med namnet {nameSearchText}";
		}
	}

	private void SortByName()
	{
		Console.WriteLine("SortByName Runs");
		if (isNameAsc)
		{
			SortByNameDesc();
		}
		else
		{
			SortByNameAsc();
		}
		isNameAsc = !isNameAsc;
		StateHasChanged();
	}
	private void SortByNameAsc() => VisibleGames = VisibleGames.OrderBy(p => p.Name).ToList();
	private void SortByNameDesc() => VisibleGames = VisibleGames.OrderByDescending(p => p.Name).ToList();


	private void SortByPrice()
	{
		Console.WriteLine("SortByPrice Runs");
		if (isPriceAsc)
		{
			SortByPriceDesc();
		}
		else
		{
			SortByPriceAsc();
		}
		isPriceAsc = !isPriceAsc;
		StateHasChanged();
	}
	private void SortByPriceAsc() => VisibleGames = VisibleGames.OrderBy(p => p.Price).ToList();
	private void SortByPriceDesc() => VisibleGames = VisibleGames.OrderByDescending(p => p.Price).ToList();

	private void OnExpandCollapseClick()
	{
		_expanded = !_expanded;
	}


	public async Task AddtoCart(GamesOverviewDto game)
	{
		if (userState.IsSignedIn)
		{
			try
			{
				var response = await httpClient.PostAsJsonAsync($"api/cart/item/{userCart}", new ShoppingCartItemCreateDto
					{
						ProductId = game.Id,
						Quantity = 1,
						PriceAtPurchase = game.Price
					});

				if (response.IsSuccessStatusCode)
				{
					_productAdded = $"{game.Name} har lagts till i varukorgen.";
				}
			}
			catch (Exception)
			{
				throw;
			}
		} else
			{
				await GuestCart.AddAsync(new ShoppingCartItemDto
				{
					ProductId = game.Id,
					Quantity = 1,
					PriceAtPurchase = game.Price,
					ProductImageUrl = game.ProductImageUrl,
					ProductName = game.Name
				});
				_productAdded = $"{game.Name} har lagts till i varukorgen.";
			}
	}



	protected override async Task OnInitializedAsync()
	{
		try
		{
			await userState.GetUserInfo();
			userCart = userState.CartId;

			var response = await httpClient.GetAsync("api/games");
			if (response.IsSuccessStatusCode)
			{
				AllGames = await response.Content.ReadFromJsonAsync<List<GamesOverviewDto>>();
				if (AllGames != null) VisibleGames = AllGames.ToList();
			}
			else
			{
				_message = response.ReasonPhrase; ;
				TempData();
			}
		}
		catch (Exception ex)
		{
			_message = $"Problem att koppla till databasen: {ex.Message}";
			TempData();
		}

		try
		{
			var response = await httpClient.GetAsync("api/pegi");
			if (response.IsSuccessStatusCode)
			{
				AllAgeRestrictions = await response.Content.ReadFromJsonAsync<List<PegiNameDto>>();
				StateHasChanged();
			}
		}
		catch (Exception)
		{

			throw;
		}
	}

	private void TempData()
	{
		var temp = new GamesOverviewDto()
			{
				Name = "Temp",
				Price = 0,
				ProductImageUrl = "https://www.shutterstock.com/image-vector/default-ui-image-placeholder-wireframes-600nw-1037719192.jpg"
			};
		for (int i = 0; i < 6; i++)
		{
			VisibleGames.Add(temp);
		}
	}
}
